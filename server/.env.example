# Copy this file to .env and fill in your real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mihurma

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# set COOKIE_SECURE=true when serving over HTTPS in production

# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:4000

# --- Stripe ---
# Get these from https://dashboard.stripe.com/apikeys
# NOTE: check that Stripe operates/supports payouts in your country before relying on it.
# If Stripe isn't available in your region, this app can be adapted to another gateway
# (e.g. Paddle, PayPal, or a local processor) by editing server/routes/orders.js only.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Notifications (ALL OPTIONAL) ---
# Each channel below is fully independent - leave any of these blank and that
# channel silently does nothing (no errors). Fill in only the ones you want active.
# To remove a channel from the codebase entirely, see server/notifications/index.js.

# Email (Nodemailer) - works with Gmail, SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mihurma <no-reply@mihurma.com>"

# SMS (Twilio) - from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp (Meta Cloud API) - from https://developers.facebook.com/apps
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Push notifications (Firebase Cloud Messaging) - paste the ENTIRE service account
# JSON file's contents on one line, from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=
